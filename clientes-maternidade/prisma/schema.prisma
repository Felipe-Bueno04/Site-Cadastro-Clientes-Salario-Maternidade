generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Cliente {
  idCliente            String    @id @default(uuid())
  nomeCompleto         String
  cpf                  String
  telefone             String
  email                String?
  instagram            String?
  origemParceira       String?
  recebeBolsaFamilia   Boolean
  tempoGestacaoSemanas Int?
  dataProvavelParto    DateTime?
  mesParto             Int?
  anoParto             Int?
  possuiSenhaGov       Boolean
  senhaGov             String?
  observacoes          String?

  statusCliente     StatusCliente
  faseProcesso      FaseProcesso
  statusContrato    StatusContrato
  statusNascimento  StatusNascimento
  dataCadastro      DateTime
  dataEnvioContrato DateTime?
  dataAssinatura    DateTime?

  alertaParto30Dias Boolean @default(false)
  alertaParto15Dias Boolean @default(false)

  pagamentos Pagamento[]

  adminId String
  admin   User   @relation("AdminClientes", fields: [adminId], references: [id])

  createdAt DateTime @default(now())
}

model Pagamento {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [idCliente])

  valor          Float
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         StatusPagamento
  createdAt      DateTime        @default(now())
  descricao      String?
  formaPagamento String?
  parcela        Int?
  totalParcelas  Int?
}

model User {
  id       String  @id @default(cuid())
  name     String?
  email    String  @unique
  password String
  role     Role    @default(PARCEIRO)

  adminCode String? @unique

  adminId   String?
  admin     User?   @relation("AdminToPartners", fields: [adminId], references: [id])
  parceiros User[]  @relation("AdminToPartners")

  clientes Cliente[] @relation("AdminClientes")

  createdAt DateTime @default(now())
}

enum StatusCliente {
  ATIVA
  INATIVA
  FINALIZADA
  CANCELADA
}

enum FaseProcesso {
  CADASTRO
  ANALISE_DOCUMENTOS
  CONTRATO_ENVIADO
  AGUARDANDO_ASSINATURA
  PROCESSO_ENVIADO_INSS
  PROCESSO_FINALIZADO
}

enum StatusContrato {
  NAO_ENVIADO
  ENVIADO
  ASSINADO
  CANCELADO
}

enum StatusNascimento {
  AGUARDANDO
  NASCEU
  NAO_INFORMADO
}

enum StatusPagamento {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

enum Role {
  ADMIN
  PARCEIRO
}
