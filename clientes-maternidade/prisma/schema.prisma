generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Cliente {
  idCliente            String           @id @default(uuid()) @map("idCliente")
  nomeCompleto         String           @map("nomeCompleto")
  cpf                  String           @map("cpf")
  telefone             String           @map("telefone")
  email                String?          @map("email")
  instagram            String?          @map("instagram")
  recebeBolsaFamilia   Boolean          @map("recebeBolsaFamilia")
  tempoGestacaoSemanas Int?             @map("tempoGestacaoSemanas")
  dataProvavelParto    DateTime?        @map("dataProvavelParto")
  mesParto             Int?             @map("mesParto")
  anoParto             Int?             @map("anoParto")
  possuiSenhaGov       Boolean          @map("possuiSenhaGov")
  senhaGov             String?          @map("senhaGov")
  observacoes          String?          @map("observacoes")
  statusCliente        StatusCliente    @map("statusCliente")
  faseProcesso         FaseProcesso     @map("faseProcesso")
  statusContrato       StatusContrato   @map("statusContrato")
  statusNascimento     StatusNascimento @map("statusNascimento")
  dataCadastro         DateTime         @map("dataCadastro")
  dataEnvioContrato    DateTime?        @map("dataEnvioContrato")
  dataAssinatura       DateTime?        @map("dataAssinatura")
  alertaParto30Dias    Boolean          @default(false) @map("alertaParto30Dias")
  alertaParto15Dias    Boolean          @default(false) @map("alertaParto15Dias")
  adminId              String           @map("adminId")
  createdAt            DateTime         @default(now()) @map("createdAt")
  criadoPor            String?          @map("criadoPor")
  admin                User             @relation("AdminClientes", fields: [adminId], references: [idUser])
  pagamentos           Pagamento[]
}

model Pagamento {
  idPagamento    String          @id @default(uuid()) @map("idPagamento")
  clienteId      String?         @map("clienteId")
  valor          Float           @map("valor")
  dataVencimento DateTime        @map("dataVencimento")
  dataPagamento  DateTime?       @map("dataPagamento")
  status         StatusPagamento @map("status")
  createdAt      DateTime        @default(now()) @map("createdAt")
  descricao      String?         @map("descricao")
  formaPagamento String?         @map("formaPagamento")
  parcela        Int?            @map("parcela")
  totalParcelas  Int?            @map("totalParcelas")
  cliente        Cliente?        @relation(fields: [clienteId], references: [idCliente])
}

model User {
  idUser    String    @id @default(cuid()) @map("idUser")
  name      String?
  email     String    @unique
  password  String
  role      Role      @default(PARCEIRO)
  adminId   String?   @map("adminId")
  createdAt DateTime  @default(now()) @map("createdAt")
  adminCode String?   @unique
  clientes  Cliente[] @relation("AdminClientes")
  admin     User?     @relation("AdminToPartners", fields: [adminId], references: [idUser])
  parceiros User[]    @relation("AdminToPartners")
}

enum StatusCliente {
  ATIVA
  INATIVA
  FINALIZADA
}

enum FaseProcesso {
  CADASTRO
  ANALISE_DOCUMENTOS
  CONTRATO_ENVIADO
  AGUARDANDO_ASSINATURA
  PROCESSO_ENVIADO_INSS
  PROCESSO_FINALIZADO
}

enum StatusContrato {
  NAO_ENVIADO
  ENVIADO
  ASSINADO
  CANCELADO
}

enum StatusNascimento {
  AGUARDANDO
  NASCEU
  NAO_INFORMADO
}

enum StatusPagamento {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

enum Role {
  ADMIN
  PARCEIRO
}
